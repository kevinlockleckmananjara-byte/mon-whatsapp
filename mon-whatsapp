<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Mon WhatsApp Clone</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; }
        body { display: flex; height: 100vh; background-color: #dadbd4; padding: 20px; }
        
        .app-container { display: flex; width: 100%; max-width: 1396px; height: 100%; margin: 0 auto; background-color: #f0f2f5; box-shadow: 0 6px 18px rgba(0,0,0,0.1); border-radius: 3px; overflow: hidden; }
        
        /* Barre latérale gauche (Contacts) */
        .sidebar { width: 35%; border-right: 1px solid #e9edef; background: white; display: flex; flex-direction: column; }
        .sidebar-header { height: 60px; background: #f0f2f5; display: flex; align-items: center; padding: 0 16px; font-weight: bold; color: #54656f; border-bottom: 1px solid #e9edef; }
        .contact-list { flex: 1; overflow-y: auto; }
        .contact-item { display: flex; align-items: center; padding: 12px 16px; cursor: pointer; border-bottom: 1px solid #f0f2f5; }
        .contact-item:hover { background-color: #f0f2f5; }
        .avatar { width: 45px; height: 45px; background: #00a884; border-radius: 50%; margin-right: 15px; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; }
        
        /* Zone de Chat principale */
        .chat-area { width: 65%; display: flex; flex-direction: column; background: #efeae2; }
        .chat-header { height: 60px; background: #f0f2f5; display: flex; align-items: center; padding: 0 16px; border-bottom: 1px solid #e9edef; }
        .chat-messages { flex: 1; padding: 24px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; }
        
        /* Bulles de messages */
        .message { max-width: 60%; padding: 8px 12px; border-radius: 8px; font-size: 14.5px; line-height: 1.4; box-shadow: 0 1px 1px rgba(0,0,0,0.05); }
        .msg-received { background: white; align-self: flex-start; border-top-left-radius: 0; }
        .msg-sent { background: #d9fdd3; align-self: flex-end; border-top-right-radius: 0; }
        
        /* Zone d'écriture en bas */
        .chat-input-area { height: 62px; background: #f0f2f5; display: flex; align-items: center; padding: 5px 10px; gap: 10px; }
        .chat-input { flex: 1; height: 42px; border: none; padding: 0 12px; border-radius: 8px; font-size: 15px; outline: none; background: white; }
        .send-btn { background: #00a884; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: bold; }
        .send-btn:hover { background: #008f70; }
    </style>
</head>
<body>

    <div class="app-container">
        <!-- Barre latérale -->
        <div class="sidebar">
            <div class="sidebar-header">Mes Discussions</div>
            <div class="contact-list">
                <div class="contact-item"><div class="avatar">M</div><div><strong>Mamy (Freelance)</strong><p style="font-size: 13px; color: #667781;">Salama ! Tu as fini le code ?</p></div></div>
                <div class="contact-item"><div class="avatar">A</div><div><strong>Aina</strong><p style="font-size: 13px; color: #667781;">On se capte à Tanà demain.</p></div></div>
            </div>
        </div>

        <!-- Zone de discussion -->
        <div class="chat-area">
            <div class="chat-header">
                <div class="avatar">M</div>
                <div><strong>Mamy (Freelance)</strong></div>
            </div>
            
            <div class="chat-messages">
                <div class="message msg-received">Salama Kevin ! Tu avances sur ton projet informatique ?</div>
                <div class="message msg-sent">Oui ! Je viens de mettre mon portfolio en ligne sur GitHub !</div>
                <div class="message msg-received">Excellent. C'est comme ça qu'on gagne de l'argent. Tu as fini le code de la messagerie ?</div>
            </div>

            <div class="chat-input-area">
                <input type="text" class="chat-input" placeholder="Tapez un message...">
                <button class="send-btn">Envoyer</button>
            </div>
        </div>
    </div>

</body>
</html>
